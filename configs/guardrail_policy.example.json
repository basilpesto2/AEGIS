{
  "schema_version": 1,
  "name": "aegis-controlled-deployment-example",
  "detector": "models/aegis/aegis_qwen25vl3b_text_detector.npz",
  "policy": {
    "block_threshold": null,
    "review_margin": null,
    "action_on_error": "review",
    "require_matching_provenance": true,
    "hash_images": false
  },
  "traffic_mode": "shadow_then_review_then_block",
  "logging": {
    "store_raw_prompts": false,
    "store_prompt_sha256": true,
    "store_image_sha256": false,
    "store_scores": true,
    "store_actions": true
  },
  "minimum_release_gate": {
    "min_samples": 32,
    "min_auroc": 0.95,
    "min_auprc": 0.95,
    "min_precision": 0.95,
    "min_recall": 0.9,
    "max_false_positive_rate": 0.01,
    "max_false_negative_rate": 0.1
  }
}
