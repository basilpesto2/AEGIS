# The API token and fingerprint key are required by the shipped Compose services.
# An API bearer token is also mandatory whenever AEGIS binds beyond loopback.
AEGIS_API_TOKEN=replace-with-a-long-random-secret
# Optional for an evaluation-only first start and same-target reuse. Required for GUI
# Settings mutations, runtime traffic-mode changes, and a rollback-safe Windows
# launcher switch away from another healthy target. It must be present when that
# running service starts. Keep it distinct from AEGIS_API_TOKEN; leaving it empty
# disables the administrative endpoint and those mutation/switch workflows.
AEGIS_ADMIN_TOKEN=
# The shipped policies use this independent secret to HMAC prompt and image fingerprints.
AEGIS_FINGERPRINT_KEY=replace-with-an-independent-long-random-secret

# Optional. Needed only when an upstream model repository requires authentication.
HF_TOKEN=
